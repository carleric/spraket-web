  "units": [
    {
      "id": "a1-u1-greetings",
      "title": "Greetings & introductions",
      "theme": "Meeting people",
      "cefr": "A1",
      "grammarFocus": "Present of være/hete; polite forms",
      "lessons": [
        {
          "id": "a1-u1-l1-hello",
          "title": "Hello & goodbye",
          "microSkill": "Core greetings",
          "cefrTarget": "A1",
          "norskprovenSkills": [
            "lese",
            "lytte"
          ],
          "canDoIds": [
            "a1-greet-basic"
          ],
          "exercises": [
            {
              "id": "e1",
              "kind": "matchPairs",
              "prompt": "Match the Norwegian greeting to English.",
              "skills": [
                "lese"
              ],
              "pairs": [
                {
                  "id": "p1",
                  "left": "hei",
                  "right": "hi"
                },
                {
                  "id": "p2",
                  "left": "god morgen",
                  "right": "good morning"
                },
                {
                  "id": "p3",
                  "left": "ha det",
                  "right": "bye"
                },
                {
                  "id": "p4",
                  "left": "takk",
                  "right": "thanks"
                }
              ],
              "accept": [],
              "explanation": "Hei is the everyday hello; ha det is a common goodbye."
            },
            {
              "id": "e2",
              "kind": "translate",
              "prompt": "Translate to Norwegian: “Hi”",
              "skills": [
                "skrive",
                "lese"
              ],
              "wordBank": [
                "hei",
                "ha",
                "det",
                "takk",
                "ja"
              ],
              "accept": [
                "hei"
              ],
              "explanation": "Hei works for hi/hello in most situations."
            },
            {
              "id": "e3",
              "kind": "listenChoose",
              "prompt": "What do you hear?",
              "skills": [
                "lytte"
              ],
              "audioText": "god morgen",
              "choices": [
                "god morgen",
                "god natt",
                "ha det",
                "unnskyld"
              ],
              "accept": [
                "god morgen"
              ],
              "explanation": "God morgen = good morning."
            },
            {
              "id": "e4",
              "kind": "orderWords",
              "prompt": "Build: “Goodbye”",
              "skills": [
                "skrive",
                "lese"
              ],
              "orderTokens": [
                "ha",
                "det",
                "takk",
                "hei"
              ],
              "accept": [
                "ha det"
              ],
              "explanation": "Ha det (literally “have it”) is a friendly bye."
            },
            {
              "id": "e5",
              "kind": "fillBlank",
              "prompt": "Complete: “___ morgen!” (good morning)",
              "skills": [
                "lese",
                "skrive"
              ],
              "accept": [
                "god"
              ],
              "explanation": "God morgen."
            },
            {
              "id": "e6",
              "kind": "dictation",
              "prompt": "Listen and type what you hear.",
              "skills": [
                "lytte",
                "skrive"
              ],
              "audioText": "takk",
              "accept": [
                "takk"
              ],
              "explanation": "Takk = thanks."
            },
            {
              "id": "e7",
              "kind": "readAnswer",
              "prompt": "Which word means “thanks”?",
              "passage": "Når noen gir deg noe, sier du ofte «takk».",
              "skills": [
                "lese"
              ],
              "choices": [
                "hei",
                "takk",
                "nei",
                "unnskyld"
              ],
              "accept": [
                "takk"
              ],
              "explanation": "Takk is thanks / thank you."
            },
            {
              "id": "e8",
              "kind": "translate",
              "prompt": "Translate to English: “Ha det”",
              "skills": [
                "lese"
              ],
              "wordBank": [
                "bye",
                "hello",
                "please",
                "sorry",
                "yes"
              ],
              "accept": [
                "bye",
                "goodbye",
                "good bye"
              ],
              "explanation": "Ha det ≈ bye / goodbye."
            }
          ]
        },
